[app]
environment = dev

[database]
host = localhost
port = 5432
username = app_user
password =
db_name =
pool_size = 10
ssl_enabled = true

[server]
host = 0.0.0.0
port = 8000
debug = false

[logging]
level = INFO
file = app.log

[grafana_cloud]
LOGS_ENABLED = false
LOGS_ENDPOINT = https://logs-prod-XXX.grafana.net/loki/api/v1/push
LOGS_USERNAME = <grafana_cloud_instance_id>
LOGS_API_KEY = <grafana_cloud_api_key>
LOGS_APP = scyes

[discord]
APP_ID =
DISCORD_TOKEN =
PUBLIC_KEY =

[langfuse]
LANGFUSE_SECRET_KEY =
LANGFUSE_PUBLIC_KEY =
LANGFUSE_BASE_URL = https://us.cloud.langfuse.com

[tavily]
TAVILY_API_KEY =

[homeassistant]
HOME_ASSISTANT_TOKEN =
HOME_ASSISTANT_BASE_URL = localhost

[google]
GOOGLE_API_KEY =
